// checker/main.rx · 走地图（STL map 内存 + 最短路）
//
// ret2shell 评测脚本：静态 flag 版本（附件型题目，无容器）。
//   check   —— 比对选手提交的 flag
//   environ —— 附件型题目没有容器，返回空对象
const FLAG = "flag{8b587367b99e5e2fcbdb6598da14b9bc}";

pub fn check(bucket, user, team, submission) {
    if submission.content == FLAG {
        return Ok((true, "Correct!", None));
    }
    Ok((false, "Incorrect!", None))
}

pub async fn environ(bucket, user, team) {
    Ok(#{})
}
